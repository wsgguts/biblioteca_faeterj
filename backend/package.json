{
  "name": "biblioteca-faeterj-api",
  "version": "1.0.0",
  "description": "API REST da Biblioteca Digital FAETERJ (Express + Prisma + SQLite + JWT)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js"
  }
}
