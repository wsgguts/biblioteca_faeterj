// Modelo de dados da Biblioteca Digital FAETERJ (ver DAS, seção 6).
// SQLite não possui enum nativo: perfis e situações são armazenados como texto
// e validados na camada de serviços.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                    Int          @id @default(autoincrement())
  nome                  String
  email                 String       @unique
  telefone              String
  matricula             String?      @unique
  senhaHash             String
  perfil                String // LEITOR | BIBLIOTECARIO | ADMINISTRADOR
  ativo                 Boolean      @default(true)
  criadoEm              DateTime     @default(now())
  emprestimos           Emprestimo[] @relation("LeitorEmprestimos")
  emprestimosRegistrados Emprestimo[] @relation("BibliotecarioEmprestimos")
  reservas              Reserva[]
  relatorios            Relatorio[]

  @@map("usuarios")
}

model Livro {
  id         Int        @id @default(autoincrement())
  isbn       String?    @unique
  titulo     String
  autor      String
  editora    String?
  ano        Int?
  assunto    String?
  criadoEm   DateTime   @default(now())
  exemplares Exemplar[]
  reservas   Reserva[]

  @@index([titulo])
  @@index([autor])
  @@index([assunto])
  @@map("livros")
}

model Exemplar {
  id          Int          @id @default(autoincrement())
  livroId     Int
  codigo      String       @unique
  localizacao String
  status      String       @default("DISPONIVEL") // DISPONIVEL | EMPRESTADO | RESERVADO | MANUTENCAO
  livro       Livro        @relation(fields: [livroId], references: [id])
  emprestimos Emprestimo[]

  @@index([livroId, status])
  @@map("exemplares")
}

model Emprestimo {
  id                    Int       @id @default(autoincrement())
  leitorId              Int
  exemplarId            Int
  bibliotecarioId       Int
  dataEmprestimo        DateTime  @default(now())
  dataPrevistaDevolucao DateTime
  dataDevolucao         DateTime?
  status                String    @default("ATIVO") // ATIVO | DEVOLVIDO (atraso é calculado)
  leitor                Usuario   @relation("LeitorEmprestimos", fields: [leitorId], references: [id])
  bibliotecario         Usuario   @relation("BibliotecarioEmprestimos", fields: [bibliotecarioId], references: [id])
  exemplar              Exemplar  @relation(fields: [exemplarId], references: [id])

  @@index([leitorId, status])
  @@index([dataPrevistaDevolucao])
  @@map("emprestimos")
}

model Reserva {
  id          Int      @id @default(autoincrement())
  leitorId    Int
  livroId     Int
  dataReserva DateTime @default(now())
  posicaoFila Int
  ativa       Boolean  @default(true)
  leitor      Usuario  @relation(fields: [leitorId], references: [id])
  livro       Livro    @relation(fields: [livroId], references: [id])

  @@index([livroId, ativa, posicaoFila])
  @@map("reservas")
}

model Relatorio {
  id            Int      @id @default(autoincrement())
  geradoPorId   Int
  tipo          String
  periodoInicio DateTime
  periodoFim    DateTime
  dataGeracao   DateTime @default(now())
  geradoPor     Usuario  @relation(fields: [geradoPorId], references: [id])

  @@map("relatorios")
}
